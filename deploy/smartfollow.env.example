# SmartFollow server configuration. Copy to /etc/smartfollow/smartfollow.env (mode 600).
# Put a value in double quotes if it contains spaces or special characters.

# Dexcom account of the sensor wearer (not a Dexcom Follow account).
DEXCOM_USERNAME=
DEXCOM_PASSWORD=
# US, OUTSIDE_US or JAPAN
DEXCOM_REGION=OUTSIDE_US

# Public HTTPS address of this server, used by the notification buttons.
SMARTFOLLOW_PUBLIC_URL=https://follow.example.com

# Generate each token with: openssl rand -hex 32
# Full access: Android app and web page.
SMARTFOLLOW_API_TOKEN=
# Only allows "Resugaring done" and "OK"; sent inside the notifications.
SMARTFOLLOW_ACTION_TOKEN=

# Notifications through ntfy. Use a long random topic name (for example
# smartfollow-<openssl rand -hex 12>): anyone who knows it can read the notifications.
NTFY_TOPIC=
#NTFY_BASE_URL=https://ntfy.sh
#NTFY_ACCESS_TOKEN=
# A still active alarm is notified again every N minutes, the urgent low more often.
NTFY_REPEAT_MINUTES=10
NTFY_URGENT_LOW_REPEAT_MINUTES=3

# Language of the notifications (en or fr) and time zone of the times they show.
SMARTFOLLOW_LANGUAGE=fr
SMARTFOLLOW_TIMEZONE=Europe/Paris

SMARTFOLLOW_DATA_DIR=/var/lib/smartfollow
# Only reachable through the reverse proxy.
SMARTFOLLOW_HOST=127.0.0.1
SMARTFOLLOW_PORT=8080
